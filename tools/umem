#!/usr/bin/env bash
# umem -- drive libumem introspection against a live pid or core.
#
# Usage:
#   umem --pid <pid>  <cmd> [args...]
#   umem --core <core> --exe <bin> <cmd> [args...]
#   umem --dump <file.ums>      <cmd> [args...]   # offline
#   umem --exe  <bin> <cmd> [args...]
#
# Commands:
#   findleaks [-f text|json] [-n N]
#   log       [-f text|json] [-n N]
#   status    [-f text|json]
#   walk      [allocated|freed|log] [-f text|json] [-n N]
#   whatis <addr>
#   snapshot <path>      # path with .ums/.umsnap/.bin gets binary v2 format
#
# Environment:
#   UMEM_TOOL_GDB=/path/to/gdb    override the gdb binary
#
# Notes:
#   Live pid mode ptraces the target, pauses it for the duration of the
#   query, then detaches.  Core mode is read-only.
#
#   For recurring automated checks (CI, monitoring), invoke with --pid
#   and -f json and feed the output to jq.

set -euo pipefail

GDB=${UMEM_TOOL_GDB:-gdb}

usage() {
	sed -n '1,/^$/{/^#/p;}' "$0" | sed 's/^# \{0,1\}//'
	exit "${1:-2}"
}

pid=
core=
exe=
dump=
cmd=
args=()

while [[ $# -gt 0 ]]; do
	case "$1" in
	--pid)      pid=$2; shift 2 ;;
	--core)     core=$2; shift 2 ;;
	--exe)      exe=$2; shift 2 ;;
	--dump)     dump=$2; shift 2 ;;
	-h|--help)  usage 0 ;;
	findleaks|log|status|whatis|snapshot|bufctl|walk)
		cmd=$1; shift
		args=("$@")
		break ;;
	*)
		echo "umem: unknown argument: $1" >&2
		usage
		;;
	esac
done

if [[ -z $cmd ]]; then
	echo "umem: no command given" >&2
	usage
fi

# Offline mode: read the snapshot directly via the python helper.
if [[ -n $dump ]]; then
	if [[ -n $pid || -n $core ]]; then
		echo "umem: --dump cannot combine with --pid/--core" >&2
		exit 2
	fi
	self_dir=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
	reader=$self_dir/umem_dump_reader
	if [[ ! -x $reader ]]; then
		echo "umem: cannot find $reader" >&2
		exit 3
	fi
	exec "$reader" --dump "$dump" "$cmd" "${args[@]}"
fi

if [[ -n $pid && -n $core ]]; then
	echo "umem: --pid and --core are mutually exclusive" >&2
	exit 2
fi
if [[ -z $pid && -z $core ]]; then
	echo "umem: need --pid or --core" >&2
	usage
fi

# Locate the script dir so we can pass umem_gdb.py by absolute path.
self_dir=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
gdb_py=$self_dir/gdb/umem_gdb.py
if [[ ! -f $gdb_py ]]; then
	echo "umem: cannot find $gdb_py" >&2
	exit 3
fi

# Build the gdb command sequence.
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

case "$cmd" in
findleaks)
	fmt=text; n=50
	while [[ ${#args[@]} -gt 0 ]]; do
		case "${args[0]}" in
		-f|--format) fmt=${args[1]}; args=("${args[@]:2}") ;;
		-n) n=${args[1]}; args=("${args[@]:2}") ;;
		*) echo "umem: unknown flag ${args[0]}" >&2; exit 2 ;;
		esac
	done
	gdb_cmd="umem findleaks -f $fmt -n $n"
	;;
log)
	fmt=text; n=0
	while [[ ${#args[@]} -gt 0 ]]; do
		case "${args[0]}" in
		-f|--format) fmt=${args[1]}; args=("${args[@]:2}") ;;
		-n) n=${args[1]}; args=("${args[@]:2}") ;;
		*) echo "umem: unknown flag ${args[0]}" >&2; exit 2 ;;
		esac
	done
	gdb_cmd="umem log -f $fmt -n $n"
	;;
status)
	fmt=text
	while [[ ${#args[@]} -gt 0 ]]; do
		case "${args[0]}" in
		-f|--format) fmt=${args[1]}; args=("${args[@]:2}") ;;
		*) echo "umem: unknown flag ${args[0]}" >&2; exit 2 ;;
		esac
	done
	gdb_cmd="umem status -f $fmt"
	;;
whatis|bufctl)
	if [[ ${#args[@]} -ne 1 ]]; then
		echo "umem: $cmd needs exactly one address" >&2
		exit 2
	fi
	gdb_cmd="umem whatis ${args[0]}"
	;;
snapshot)
	if [[ ${#args[@]} -ne 1 ]]; then
		echo "umem: snapshot needs exactly one path" >&2
		exit 2
	fi
	gdb_cmd="umem snapshot ${args[0]}"
	;;
walk)
	kind=allocated; fmt=text; n=0
	while [[ ${#args[@]} -gt 0 ]]; do
		case "${args[0]}" in
		allocated|freed|log) kind=${args[0]}; args=("${args[@]:1}") ;;
		-f|--format) fmt=${args[1]}; args=("${args[@]:2}") ;;
		-n) n=${args[1]}; args=("${args[@]:2}") ;;
		*) echo "umem: unknown flag ${args[0]}" >&2; exit 2 ;;
		esac
	done
	gdb_cmd="umem walk $kind -f $fmt -n $n"
	;;
esac

cat >"$tmp" <<EOF
set pagination off
set confirm off
set print elements 0
set print inferior-events off
set print thread-events off
source $gdb_py
echo __LIBUMEM_TOOL_BEGIN__\n
$gdb_cmd
echo __LIBUMEM_TOOL_END__\n
EOF

# --batch-silent suppresses banners but also discards gdb.write() output;
# we use --batch and bracket the relevant output with sentinels filtered
# by awk so the result is clean enough to pipe to jq.
#
# Auto-load safe-path and debuginfod-off must come *before* -p so they
# apply to libthread_db resolution at attach time.
base_args=(--batch --quiet
	-iex 'set auto-load safe-path /'
	-iex 'set debuginfod enabled off'
	-iex 'set print inferior-events off'
	-iex 'set print thread-events off')

if [[ -n $pid ]]; then
	if [[ -n $exe ]]; then
		gdb_args=("${base_args[@]}" "$exe" -p "$pid" -x "$tmp")
	else
		gdb_args=("${base_args[@]}" -p "$pid" -x "$tmp")
	fi
elif [[ -n $core ]]; then
	if [[ -z $exe ]]; then
		echo "umem: --core requires --exe" >&2
		exit 2
	fi
	gdb_args=("${base_args[@]}" "$exe" --core="$core" -x "$tmp")
fi

"$GDB" "${gdb_args[@]}" 2>/dev/null | awk '
	BEGIN { started=0 }
	/^__LIBUMEM_TOOL_BEGIN__$/ { started=1; next }
	/^__LIBUMEM_TOOL_END__$/ { started=0; next }
	started { print }
'
