.TH UMEM_HOOKS 3MALLOC "December 2024"
.SH NAME
umem_hooks \- application allocator hook API
.SH SYNOPSIS
.LP
.nf
cc [ \fIflag \&.\|.\|.\fR ] \fIfile\fR\&.\|.\|. \fB-lumem\fR [ \fIlibrary \&.\|.\|.\fR ]
#include <umem_hooks.h>

\fBint\fR \fBumem_hook_register\fR(\fBumem_hook_t *\fR\fIhook\fR);
.fi

.LP
.nf
\fBvoid\fR \fBumem_hook_unregister\fR(\fBumem_hook_t *\fR\fIhook\fR);
.fi

.LP
.nf
\fBvoid *\fR\fBumem_hook_track_alloc\fR(\fBumem_hook_t *\fR\fIhook\fR, \fBsize_t\fR \fIsize\fR);
.fi

.LP
.nf
\fBvoid\fR \fBumem_hook_track_free\fR(\fBumem_hook_t *\fR\fIhook\fR, \fBvoid *\fR\fIptr\fR,
     \fBsize_t\fR \fIsize\fR);
.fi

.LP
.nf
\fBvoid *\fR\fBumem_hook_track_realloc\fR(\fBumem_hook_t *\fR\fIhook\fR, \fBvoid *\fR\fIptr\fR,
     \fBsize_t\fR \fIold_size\fR, \fBsize_t\fR \fInew_size\fR);
.fi

.LP
.nf
\fBvoid\fR \fBumem_hook_dump\fR(\fBFILE *\fR\fIfp\fR);
.fi

.LP
.nf
\fBvoid\fR \fBumem_hook_dump_one\fR(\fBFILE *\fR\fIfp\fR, \fBumem_hook_t *\fR\fIhook\fR);
.fi

.LP
.nf
\fBumem_hook_t *\fR\fBumem_hook_find\fR(\fBconst char *\fR\fIname\fR);
.fi

.LP
.nf
\fBint\fR \fBumem_hook_walk\fR(\fBumem_hook_walk_f\fR \fIfunc\fR, \fBvoid *\fR\fIarg\fR);
.fi

.SH DESCRIPTION
.sp
.LP
The \fBumem_hooks\fR API allows applications to integrate custom allocators
with \fBlibumem\fR for unified memory tracking and debugging. This is useful
for applications that embed scripting languages, databases with custom memory
contexts, or any system with multiple allocator subsystems.
.sp
.LP
A hook consists of:
.RS +4
.TP
.ie t \(bu
.el o
Allocation, free, and optionally realloc functions
.RE
.RS +4
.TP
.ie t \(bu
.el o
A unique name for identification
.RE
.RS +4
.TP
.ie t \(bu
.el o
Optional application-specific context
.RE
.RS +4
.TP
.ie t \(bu
.el o
Statistics automatically maintained by umem
.RE
.SS "Hook Structure"
.sp
.LP
The \fBumem_hook_t\fR structure contains:
.sp
.in +2
.nf
typedef struct umem_hook {
    const char *hook_name;
    umem_hook_alloc_f hook_alloc;
    umem_hook_free_f hook_free;
    umem_hook_realloc_f hook_realloc;  /* optional */
    void *hook_arg;

    /* Statistics (read-only) */
    uint64_t alloc_count;
    uint64_t free_count;
    uint64_t realloc_count;
    uint64_t bytes_allocated;
    uint64_t bytes_freed;
    uint64_t bytes_current;
    uint64_t peak_bytes;
} umem_hook_t;
.fi
.in -2
.SS "Registration and Cleanup"
.sp
.LP
The \fBumem_hook_register()\fR function registers a hook with the system.
The hook structure must remain valid for the lifetime of the registration.
Returns 0 on success, -1 on error (duplicate name or NULL hook).
.sp
.LP
The \fBumem_hook_unregister()\fR function removes a previously registered
hook. The hook structure can be freed after this call returns.
.SS "Tracking Functions"
.sp
.LP
The tracking functions update hook statistics and should be called by the
application's allocator wrapper:
.sp
.LP
\fBumem_hook_track_alloc()\fR increments allocation count and byte counters.
Call this after a successful allocation.
.sp
.LP
\fBumem_hook_track_free()\fR increments free count and updates byte counters.
Call this before freeing memory.
.sp
.LP
\fBumem_hook_track_realloc()\fR handles realloc tracking, adjusting both
allocation and free counters as appropriate.
.SS "Statistics and Debugging"
.sp
.LP
The \fBumem_hook_dump()\fR function writes statistics for all registered
hooks to the specified file pointer.
.sp
.LP
The \fBumem_hook_dump_one()\fR function writes statistics for a single hook.
.sp
.LP
The \fBumem_hook_find()\fR function looks up a hook by name. Returns NULL
if not found.
.sp
.LP
The \fBumem_hook_walk()\fR function calls \fIfunc\fR for each registered
hook, passing the hook pointer and \fIarg\fR. If \fIfunc\fR returns non-zero,
the walk terminates early.
.SH RETURN VALUES
.sp
.LP
\fBumem_hook_register()\fR returns 0 on success, -1 on error.
.sp
.LP
\fBumem_hook_find()\fR returns a pointer to the hook or NULL if not found.
.sp
.LP
\fBumem_hook_walk()\fR returns the last return value from \fIfunc\fR, or 0
if all hooks were visited.
.SH EXAMPLES
.LP
\fBExample 1 \fRBasic hook integration
.sp
.in +2
.nf
#include <umem_hooks.h>

/* Custom allocator context */
typedef struct my_allocator {
    void *base;
    size_t size;
} my_allocator_t;

/* Hook functions */
static void *
my_alloc(size_t size, void *arg)
{
    my_allocator_t *alloc = (my_allocator_t *)arg;
    /* ... custom allocation logic ... */
    return ptr;
}

static void
my_free(void *ptr, void *arg)
{
    my_allocator_t *alloc = (my_allocator_t *)arg;
    /* ... custom free logic ... */
}

/* Setup */
my_allocator_t my_ctx;
umem_hook_t my_hook = {
    .hook_name = "my_allocator",
    .hook_alloc = my_alloc,
    .hook_free = my_free,
    .hook_arg = &my_ctx
};

if (umem_hook_register(&my_hook) != 0) {
    /* handle error */
}

/* Use tracking in wrapper functions */
void *
my_malloc(size_t size)
{
    void *ptr = umem_hook_track_alloc(&my_hook, size);
    return ptr;
}

void
my_free_wrapper(void *ptr, size_t size)
{
    umem_hook_track_free(&my_hook, ptr, size);
}

/* Dump statistics */
umem_hook_dump(stdout);

/* Cleanup */
umem_hook_unregister(&my_hook);
.fi
.in -2

.LP
\fBExample 2 \fRPostgreSQL palloc integration
.sp
See \fBexamples/palloc_integration.c\fR for a complete example of integrating
PostgreSQL's palloc memory management system with umem hooks.
